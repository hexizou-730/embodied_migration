# Copy this file to .env and fill in one provider's key.

# Paper environment defaults are frozen in experiment_config.json.
EM_LLM_PROVIDER=openrouter
EM_MODEL=openai/gpt-5.6-luna
EM_MAX_TOKENS=16384
EM_TEMPERATURE=0.0
EM_REASONING_EFFORT=low
EM_EXCLUDE_REASONING=true
EM_LLM_SEED=0
EM_OPENROUTER_PROVIDER=openai
EM_OPENROUTER_ALLOW_FALLBACKS=true

OPENROUTER_API_KEY=your_openrouter_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Used only when EM_LLM_PROVIDER=deepseek instead of the frozen OpenRouter setup.
# EM_DEEPSEEK_THINKING=disabled
